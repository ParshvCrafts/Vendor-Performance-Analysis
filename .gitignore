# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
serviceAccount*.json

# Data: raw extracts are ~1.9GB (sales.csv alone 1.5GB; GitHub caps files at 100MB).
# Only the small files in data/sample/ are committed.
data/raw/
data/processed/
*.csv
!data/sample/*.csv

# Local-only: pre-sanitization drafts (contain a plaintext password) and run logs
archive/
logs/
*.log

# Python
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Notebook verification runs
notebooks/_verify_run*.ipynb
