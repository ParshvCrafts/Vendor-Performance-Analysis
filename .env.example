# Copy to .env and fill in. .env is gitignored - never commit real values.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
# WARNING: src/ingest_db.py DROPS and recreates this database on every run.
MYSQL_DATABASE=vendor

# Optional overrides (defaults: <repo>/data/raw and <repo>/logs)
# DATA_DIR=
# LOG_DIR=
